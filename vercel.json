{
  "functions": {
    "api/survey.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/aggregate",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/meeting-prompts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/meeting-prompts",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/survey",
      "destination": "/survey/index.html"
    },
    {
      "source": "/letter",
      "destination": "/letter/index.html"
    },
    {
      "source": "/event-volunteers",
      "destination": "/event-volunteers/index.html"
    },
    {
      "source": "/api/event-volunteers",
      "destination": "/api/survey?form=event-volunteers"
    },
    {
      "source": "/support/gina",
      "destination": "/support/gina.html"
    },
    {
      "source": "/support/simon",
      "destination": "/support/simon.html"
    },
    {
      "source": "/api/support-groups",
      "destination": "/api/survey?form=support-groups"
    },
    {
      "source": "/support/send",
      "destination": "/support/send.html"
    },
    {
      "source": "/api/meetings",
      "destination": "/api/survey?form=meetings"
    },
    {
      "source": "/api/meeting-prompts",
      "destination": "/api/survey?form=meeting-prompts"
    },
    {
      "source": "/support/attendance",
      "destination": "/support/attendance.html"
    },
    {
      "source": "/api/attendance",
      "destination": "/api/survey?form=attendance"
    },
    {
      "source": "/api/meeting-attendance",
      "destination": "/api/survey?form=meeting-attendance"
    },
    {
      "source": "/support/status",
      "destination": "/support/status.html"
    },
    {
      "source": "/api/status",
      "destination": "/api/survey?form=status"
    },
    {
      "source": "/api/agreement-invite",
      "destination": "/api/survey?form=agreement-invite"
    },
    {
      "source": "/api/website-inquiry",
      "destination": "/api/survey?form=website-inquiry"
    },
    {
      "source": "/feedback/:id(\\d+)/lead",
      "destination": "/api/page?id=:id&lead=1"
    },
    {
      "source": "/feedback/:id(\\d+)/photos",
      "destination": "/api/page?id=:id&photos=1"
    },
    {
      "source": "/feedback/:id(\\d+)",
      "destination": "/api/page?id=:id"
    },
    {
      "source": "/multi",
      "destination": "/api/page?multi=1"
    },
    {
      "source": "/:id(\\d+)/lead",
      "destination": "/api/page?id=:id&lead=1"
    },
    {
      "source": "/:id(\\d+)/photos",
      "destination": "/api/page?id=:id&photos=1"
    },
    {
      "source": "/:id(\\d+)",
      "destination": "/api/page?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/support/send",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/support/attendance",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/support/status",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/support/send.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/support/attendance.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/support/status.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(meetings|attendance|status|meeting-prompts|meeting-attendance)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
